<Window
    x:Class="SutraWindows.ActivationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sutra Activation Gate">

    <!-- 500px Obsidian Terracotta Activation Card -->
    <Grid Background="{StaticResource SutraBackgroundDark}" Padding="28" Width="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="SUTRA SOVEREIGN LICENSE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SutraAccentBrush}" Margin="0,0,0,4" />
            <TextBlock Text="Device Activation Gate" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SutraTextPrimary}" Margin="0,0,0,6" />
            <TextBlock Text="Sutra is cryptographically bound to your hardware. Whitelist your registered email via Cloudflare, or enter your offline unlock code." 
                       FontSize="11.5" Foreground="{StaticResource SutraTextMuted}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Device ID Card -->
        <Border Grid.Row="1" Background="{StaticResource SutraCardBackground}" CornerRadius="8" BorderThickness="1" BorderBrush="#33FFFFFF" Padding="12,8" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="HARDWARE DEVICE ID" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SutraTextMuted}" />
                    <TextBlock x:Name="DeviceIdText" Text="SUTRA-0000-0000" FontSize="14" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{StaticResource SutraTextPrimary}" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CopyButton" Content="Copy ID" FontSize="11" Click="OnCopyDeviceClick" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Method A: Online Email Whitelist -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Method 1: Whitelisted Account Activation (Online)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SutraTextPrimary}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="EmailInput" PlaceholderText="Enter your whitelisted email..." FontSize="12" Margin="0,0,8,0" KeyDown="OnEmailKeyDown" />
                <Button Grid.Column="1" x:Name="ActivateOnlineBtn" Content="Verify &amp; Activate" Background="{StaticResource SutraAccentBrush}" Foreground="White" FontSize="12" Click="OnActivateOnlineClick" />
            </Grid>
        </StackPanel>

        <!-- Divider -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="1" Background="#26FFFFFF" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="OR USE OFFLINE UNLOCK CODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SutraTextMuted}" Margin="12,0" />
            <Border Grid.Column="2" Height="1" Background="#26FFFFFF" VerticalAlignment="Center" />
        </Grid>

        <!-- Method B: Offline Unlock Code -->
        <StackPanel Grid.Row="4" Margin="0,0,0,14">
            <TextBlock Text="Method 2: Offline 8-Digit Code" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SutraTextPrimary}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="CodeInput" PlaceholderText="e.g. 8A3F-9B1C" FontFamily="Consolas, monospace" FontSize="13" Margin="0,0,8,0" KeyDown="OnCodeKeyDown" />
                <Button Grid.Column="1" x:Name="UnlockOfflineBtn" Content="Unlock Machine" FontSize="12" Click="OnUnlockOfflineClick" />
            </Grid>
        </StackPanel>

        <!-- Status Message / Spinner -->
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressRing x:Name="ProgressIndicator" IsActive="False" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed" />
                <TextBlock x:Name="StatusLabel" Text="" FontSize="11.5" Foreground="{StaticResource SutraAccentBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Footer Notice -->
        <TextBlock Grid.Row="6" Text="All cues and databases remain 100% sovereign and local. Whitelist requests are processed by Ramesh Choudhary." 
                   FontSize="10" Foreground="{StaticResource SutraTextMuted}" TextWrapping="Wrap" />
    </Grid>
</Window>
