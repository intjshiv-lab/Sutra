<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SutraWindows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    
    <AssemblyName>Sutra</AssemblyName>
    <Nullable>enable</Nullable>
    
    <!-- WinUI 3 Unpackaged Standalone Specification -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationIcon>app.ico</ApplicationIcon>
    
    <!-- Zero-Bloat Standalone WinUI 3 Specification -->
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    
    <!-- App Metadata -->
    <AssemblyTitle>Sutra</AssemblyTitle>
    <Description>Sutra Sovereign Attention Thread &amp; Context-Waking Engine</Description>
    <Product>Sutra for Windows</Product>
    <Company>Sutra Sovereign Engineering Hub</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250207001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <!-- Embed native sutra_ffi.dll and icon into output and publish directory -->
  <ItemGroup>
    <None Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="sutra_ffi.dll" Condition="Exists('sutra_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\crates\sutra-ffi\target\release\sutra_ffi.dll" Condition="!Exists('sutra_ffi.dll') And Exists('..\..\crates\sutra-ffi\target\release\sutra_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\target\x86_64-pc-windows-msvc\release\sutra_ffi.dll" Condition="!Exists('sutra_ffi.dll') And !Exists('..\..\crates\sutra-ffi\target\release\sutra_ffi.dll') And Exists('..\..\target\x86_64-pc-windows-msvc\release\sutra_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Release Build Hard Guard: Fail loudly if native sutra_ffi.dll is missing -->
  <Target Name="ValidateRustFFIDLL" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('sutra_ffi.dll') And !Exists('..\..\crates\sutra-ffi\target\release\sutra_ffi.dll') And !Exists('..\..\target\x86_64-pc-windows-msvc\release\sutra_ffi.dll')"
           Text="CRITICAL: sutra_ffi.dll not found! Build crates/sutra-ffi or copy sutra_ffi.dll to apps/sutra-windows/ before creating a Release build." />
  </Target>
</Project>
