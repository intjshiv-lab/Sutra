<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SutraWindows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    
    <!-- WinUI 3 Unpackaged Standalone Specification -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    
    <!-- Zero-Bloat Standalone WinUI 3 Specification -->
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    
    <!-- App Metadata -->
    <AssemblyTitle>Sutra</AssemblyTitle>
    <Description>Sutra Sovereign Attention Thread &amp; Context-Waking Engine</Description>
    <Product>Sutra for Windows</Product>
    <Company>Sutra Sovereign Engineering Hub</Company>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <!-- Embed native sutra_ffi.dll into output directory -->
  <ItemGroup>
    <None Include="..\..\crates\sutra-ffi\target\release\sutra_ffi.dll" Condition="Exists('..\..\crates\sutra-ffi\target\release\sutra_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
