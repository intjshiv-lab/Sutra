<Window
    x:Class="SutraWindows.SanctuaryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sutra Sanctuary">

    <!-- 460px Studio Obsidian Popover -->
    <Grid Background="{StaticResource SutraBackgroundDark}" Padding="16" Width="460" Height="580">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Title + Centered Circular Thread Counter Capsule + Add Cue -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Sutra Sanctuary" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SutraTextPrimary}" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Border Background="#26262B" BorderBrush="#3A3A40" BorderThickness="1" CornerRadius="11" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CountBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="White" />
            </Border>
            <Button Content="+ Cue" HorizontalAlignment="Right" Click="OnAddCueClick" />
        </Grid>

        <!-- Interactive Search Bar -->
        <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="Search threads..." FontSize="12" Margin="0,0,0,10" TextChanged="OnSearchTextChanged" />

        <!-- Collapsible Today Accordion -->
        <Border Grid.Row="2" Background="{StaticResource SutraCardBackground}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Scheduled for Today" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SutraAccentBrush}" VerticalAlignment="Center" />
                    <Button Content="▾" HorizontalAlignment="Right" Padding="4,0" Click="OnToggleTodayAccordion" />
                </Grid>
                <ItemsControl x:Name="TodayItemsList" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Active Waiting Threads List -->
        <ScrollViewer Grid.Row="3" Margin="0,0,0,10">
            <ItemsControl x:Name="WaitingThreadsList" />
        </ScrollViewer>

        <!-- Bottom Action Bar: Centered Archive Toggle -->
        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Button x:Name="ArchiveToggleBtn" Content="Archive" FontSize="11" HorizontalAlignment="Center" Padding="12,4" Click="OnArchiveToggleClick" />
        </Grid>
    </Grid>
</Window>
