{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Sutra",
  "version": "0.2.0",
  "identifier": "com.sutra.agnostic",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "sanctuary",
        "title": "Sutra Sanctuary",
        "width": 460,
        "height": 460,
        "minHeight": 380,
        "maxHeight": 800,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "quickcue",
        "title": "Sutra Quick Cue",
        "width": 460,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true
      },
      {
        "label": "wakebar",
        "title": "Sutra Floating Bar",
        "width": 460,
        "height": 64,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["en-US"]
      }
    }
  },
  "plugins": {
    "global-shortcut": {}
  }
}
